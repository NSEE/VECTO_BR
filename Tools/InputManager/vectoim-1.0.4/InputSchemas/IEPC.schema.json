{
  "definitions": {
    "AxleInput": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "Ratio": {
          "description": "Axle gear ratio",
          "type": "number",
          "minimum": 0.1,
          "maximum": 100.0
        },
        "GearMeshType": {
          "description": "Axle gear mesh type (only one can be selected)",
          "type": "string",
          "enum": [
            "Bevel",
            "SpurPlanetary"
          ]
        },
        "ExternalExternalGearMeshes": {
          "description": "Number of external-external gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "ExternalInternalGearMeshes": {
          "description": "Number of external-internal gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "AngleDriveGearMeshes": {
          "description": "Number of angle drive gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "BevelGearMeshes": {
          "description": "Number of bevel gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        }
      },
      "required": [
        "Ratio",
        "GearMeshType",
        "ExternalExternalGearMeshes",
        "ExternalInternalGearMeshes",
        "AngleDriveGearMeshes",
        "BevelGearMeshes"
      ]
    },
    "GearboxInput": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "Tmaxin": {
          "description": "Maximum allowed input torque [Nm]",
          "type": "number",
          "minimum": 0.0,
          "maximum": 100000000.0
        },
        "DirectGear": {
          "description": "Direct gear flag (true only if ratio is 1)",
          "type": "boolean"
        },
        "MoreThan2FrictionClutches": {
          "description": "Contains more than 2 friction clutches",
          "type": "boolean"
        },
        "ExternalExternalGearMeshes": {
          "description": "Number of external-external gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "ExternalInternalGearMeshes": {
          "description": "Number of external-internal gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        },
        "AngleDriveGearMeshes": {
          "description": "Number of angle drive gear meshes",
          "type": "integer",
          "minimum": 0.0,
          "maximum": 10.0
        }
      },
      "required": [
        "Tmaxin",
        "DirectGear",
        "MoreThan2FrictionClutches",
        "ExternalExternalGearMeshes",
        "ExternalInternalGearMeshes",
        "AngleDriveGearMeshes"
      ]
    },
    "IEPCGearInput": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "Number": {
          "description": "Gear number",
          "type": "integer"
        },
        "Ratio": {
          "description": "Gear ratio",
          "type": "number"
        },
        "MaxOutShaftSpeed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "MaxOutShaftTorque": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "Number",
        "Ratio",
        "MaxOutShaftSpeed",
        "MaxOutShaftTorque"
      ]
    },
    "MaxTorqueCurveEntry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "OutShaftSpeed": {
          "description": "Output shaft speed [1/min]",
          "type": "number",
          "minimum": 0.0,
          "maximum": 30000.0
        },
        "MaxTorque": {
          "description": "Maximum torque [Nm]",
          "type": "number",
          "minimum": -50000.0,
          "maximum": 50000.0
        },
        "MinTorque": {
          "description": "Minimum torque [Nm]",
          "type": "number",
          "minimum": -50000.0,
          "maximum": 50000.0
        }
      },
      "required": [
        "OutShaftSpeed",
        "MaxTorque",
        "MinTorque"
      ]
    }
  },
  "type": "object",
  "properties": {
    "Component": {
      "type": "string",
      "enum": [
        "IEPC"
      ]
    },
    "Gearbox": {
      "$ref": "#/definitions/GearboxInput"
    },
    "Axle": {
      "$ref": "#/definitions/AxleInput"
    },
    "ElectricMachineType": {
      "description": "Electric machine type",
      "type": "string",
      "enum": [
        "ASM",
        "ESM",
        "PSM",
        "RM"
      ]
    },
    "R85RatedPower": {
      "description": "R85 rated power [W]",
      "type": "integer",
      "minimum": 1000.0,
      "maximum": 1000000.0
    },
    "RotationalInertia": {
      "description": "Rotational inertia [kg·m²]",
      "type": "number",
      "minimum": 0.001,
      "maximum": 10.0
    },
    "DesignTypeWheelMotor": {
      "description": "Design type wheel motor",
      "type": "boolean"
    },
    "NrOfDesignTypeWheelMotorMeasured": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "Item1",
        "Item2"
      ]
    },
    "DisengagementClutch": {
      "description": "Disengagement clutch",
      "type": [
        "boolean",
        "null"
      ]
    },
    "ContinuousTorque": {
      "description": "Continuous torque [Nm]",
      "type": "number",
      "minimum": 1.0,
      "maximum": 50000.0
    },
    "TestSpeedContinuousTorque": {
      "description": "Test speed for continuous torque [1/min]",
      "type": "number",
      "minimum": 1.0,
      "maximum": 30000.0
    },
    "OverloadTorque": {
      "description": "Overload torque [Nm]",
      "type": "number",
      "minimum": 1.0,
      "maximum": 50000.0
    },
    "TestSpeedOverloadTorque": {
      "description": "Test speed for overload torque [1/min]",
      "type": "number",
      "minimum": 1.0,
      "maximum": 30000.0
    },
    "OverloadDuration": {
      "description": "Overload duration [s]",
      "type": "number",
      "minimum": 1.0,
      "maximum": 300.0
    },
    "SpeedSetpoints": {
      "description": "Speed setpoints [rpm]",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      }
    },
    "TorqueSetpoints": {
      "description": "Torque setpoints [Nm]",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "number"
      }
    },
    "Gears": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/IEPCGearInput"
      }
    },
    "MaxTorqueCurve": {
      "description": "Maximum torque curve entries",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/MaxTorqueCurveEntry"
      },
      "minItems": 2
    },
    "Manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "Model": {
      "type": "string",
      "minLength": 1
    },
    "CertificationNumber": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "Component",
    "Gearbox",
    "Axle",
    "ElectricMachineType",
    "R85RatedPower",
    "RotationalInertia",
    "DesignTypeWheelMotor",
    "NrOfDesignTypeWheelMotorMeasured",
    "DisengagementClutch",
    "ContinuousTorque",
    "TestSpeedContinuousTorque",
    "OverloadTorque",
    "TestSpeedOverloadTorque",
    "OverloadDuration",
    "SpeedSetpoints",
    "TorqueSetpoints",
    "Gears",
    "MaxTorqueCurve",
    "Manufacturer",
    "Model",
    "CertificationNumber"
  ]
}