<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

	<targets>
		<!-- Console target with colored output -->
		<target xsi:type="ColoredConsole"
				name="console"
				layout="${when:when=level!=LogLevel.Info:inner=${level:uppercase=true}\: }${message} ${exception:format=tostring}"
				useDefaultRowHighlightingRules="true">
			<highlight-row condition="level == LogLevel.Trace" foregroundColor="DarkGray" />
			<highlight-row condition="level == LogLevel.Debug" foregroundColor="DarkGray" />
			<highlight-row condition="level == LogLevel.Info" foregroundColor="Gray" />
			<highlight-row condition="level == LogLevel.Warn" foregroundColor="Yellow" />
			<highlight-row condition="level == LogLevel.Error" foregroundColor="Red" />
			<highlight-row condition="level == LogLevel.Fatal" foregroundColor="Red" backgroundColor="White" />
		</target>

		<!-- File target for internal logging -->
		<target xsi:type="File"
				name="file"
				fileName="${specialfolder:folder=LocalApplicationData}\vecto\vectoim-${shortdate}-${time:format=HHmmss:cached=true}.log"
				layout="${longdate} ${level:uppercase=true:padding=-5} ${logger} ${message} ${exception:format=tostring}"
				maxArchiveFiles="100"
				createDirs="true" />
	</targets>

	<rules>
		<!-- Adjust minlevel as needed (Trace, Debug, Info, Warn, Error, Fatal) -->
		<logger name="*" minlevel="Info" writeTo="console" />
		<logger name="*" minlevel="Info" writeTo="file" />
	</rules>
</nlog>